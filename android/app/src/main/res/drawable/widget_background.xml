<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: a soft vertical gradient with a hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_surface_bottom"
        android:startColor="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_stroke" />
    <corners android:radius="@dimen/widget_corner" />
</shape>
