<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 by default; 2x2 shows the next event, larger sizes list 1 to 5 events. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="560dp"
    android:maxResizeHeight="560dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_upcoming_small"
    android:previewLayout="@layout/widget_upcoming_preview"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
